{
  "name": "vivagraphjs",
  "version": "1.0.0-alpha.2",
  "description": "Draws graphs in the browser: force layout, WebGL drawing, labels and interaction in one call",
  "type": "module",
  "main": "dist/vivagraph.js",
  "module": "dist/vivagraph.module.js",
  "jsdelivr": "dist/vivagraph.min.js",
  "unpkg": "dist/vivagraph.min.js",
  "exports": {
    ".": {
      "import": "./dist/vivagraph.module.js",
      "default": "./dist/vivagraph.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "start": "rollup -c -w",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser/run.js",
    "site": "node scripts/site.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvaka/VivaGraphJS.git"
  },
  "keywords": [
    "graph",
    "network",
    "visualization",
    "force layout",
    "webgl",
    "ngraph"
  ],
  "author": "Andrei Kashcha",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "ngraph.events": "^1.4.0",
    "ngraph.forcelayout": "https://codeload.github.com/anvaka/ngraph.forcelayout/tar.gz/6e62c1972f54f7ae33cc06c804dff88fbe6dbdfd",
    "ngraph.graph": "^20.1.2",
    "puppeteer-core": "^25.18.1",
    "rollup": "^4.68.8",
    "terser": "^5.51.4",
    "w-gl": "^0.21.1"
  }
}
